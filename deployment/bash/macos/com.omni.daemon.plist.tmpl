<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.omni.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>{{OMNI_SERVER}}</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>{{HOME}}</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:{{LOCAL_BIN}}</string>
    <!-- macOS: $TMPDIR is set per-session by launchd; socket paths resolve via pkg/sockpath -->
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>{{HOME}}/Library/Logs/omni/omni-server.log</string>

  <key>StandardErrorPath</key>
  <string>{{HOME}}/Library/Logs/omni/omni-server.err</string>
</dict>
</plist>
